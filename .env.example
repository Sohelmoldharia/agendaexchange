# Copy to .env and adjust as needed.

# SQLite database file (relative to project root).
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL — used for SEO canonical links, sitemap.xml, and OG tags.
# Set this to your real domain in production (e.g. https://animeindex.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
